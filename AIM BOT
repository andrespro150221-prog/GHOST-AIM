    keyStroke.Thickness = 1

    local keyGrad = Instance.new("UIGradient", keyBtn)
    keyGrad.Rotation = 90
    keyGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.GlassLight),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(22, 25, 33))
    })

