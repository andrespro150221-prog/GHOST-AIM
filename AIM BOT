local function protectUI()
    if not _G.FlowUI or not _G.FlowUI.Parent then
        CreateGUI()
        if UI_Visible and _G.FlowContainer then
            _G.FlowContainer.Visible = true
            _G.FlowUI.Enabled = true
        end
    end
end

if guiParent then
    guiParent.ChildRemoved:Connect(function(child)
        if child == _G.FlowUI then
            task.wait(0.1)
            protectUI()
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(2)
        if _G.FlowUI and not _G.FlowUI.Parent then
            protectUI()
        end
    end
end)

