--  UI PROTECTOR (Anti-Delete / Auto-Restore)
-- ═══════════════════════════════════════════  
local UIProtector = {
    roots  = { Gui, Container, MobileToggleBtn },
    hooked = false,
    paused = false,
}

local function isProtectedInstance(instance)
    for i = 1, #UIProtector.roots do
        local root = UIProtector.roots[i]
        if root and (instance == root or instance:IsDescendantOf(root)) then
            return true
        end
    end
    return false
end

UIProtector.installHook = function()
    if UIProtector.hooked then return end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local args = { ... }
            local method = getnamecallmethod()
            if not UIProtector.paused and (method == "Destroy" or method == "Remove") then
                local inst = self
                while inst do
                    if isProtectedInstance(inst) then return end
                    inst = inst.Parent
                end
            end
            if not UIProtector.paused and method == "ClearAllChildren" and isProtectedInstance(self) then
                return
            end
            return oldNamecall(self, unpack(args))
        end)
        setreadonly(mt, true)
    end)
    UIProtector.hooked = true
    return ok
end

