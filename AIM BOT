local AlphaSet = "abcdefghijklmnopqrstuvwxyz0123456789"

local function rndName()
    local len = math.random(6, 11)
    local s = {}
    for i = 1, len do
        local idx = math.random(1, #AlphaSet)
        s[i] = AlphaSet:sub(idx, idx)
    end
    return table.concat(s)
end

math.randomseed(tick() * 100000 + os.clock() * 1000)

local UI_NAMES_TO_SCRUB = {
    Gui, Container, DropShadow, Win, WinGradient, Glare, GlareGrad,
    GlassStroke, TopBar, DragHandle, Title, TitleDot, MinBtn, CloseBtn,
    ResizeBtn, ResizeIcon, Content, ListLayout, ContentPadding,
    MobileToggleBtn, MobileGrad, MobileStroke,
    serverPanel, serverLabel, serverStroke,
}

local function scrubNames()
    for i = 1, #UI_NAMES_TO_SCRUB do
        local inst = UI_NAMES_TO_SCRUB[i]
        if inst and inst.Parent then
            inst.Name = rndName()
        end
    end
end

local function scrubHighlights()
    for _, h in pairs(HighlightCache) do
        if h and h.Parent then
            h.Name = rndName()
        end
    end
end

