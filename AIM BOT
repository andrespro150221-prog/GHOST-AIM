local mainLoop = RunService.RenderStepped:Connect(function(dt)  
    if not ScriptActive then  
        mainLoop:Disconnect()  
        return  
    end  
    local centerScreen = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)  
    local isLockedValid = false  
    if Config.LockedTarget and Config.LockedTarget.Parent then
        local hum = Config.LockedTarget.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and isPartVisible(Config.LockedTarget) then  
            local pos, onScreen = Camera:WorldToScreenPoint(Config.LockedTarget.Position)  
            if onScreen and pos.Z > 0 then isLockedValid = true end  
        end  
    end  
    local currentTarget = nil  
    if Config.TargetLock then  
        if isLockedValid then  
            currentTarget = Config.LockedTarget  
        else  
            Config.LockedTarget = nil  
            currentTarget = getClosest()  
            if currentTarget then Config.LockedTarget = currentTarget end  
        end  
    else  
        Config.LockedTarget = nil  
        currentTarget = getClosest()  
    end  

    if fovCircle then
        fovCircle.Position = centerScreen  
        fovCircle.Radius = Config.FOV / 2  
        fovCircle.Visible = Config.ShowFOV  
    end
    if centerDot then
        centerDot.Position = centerScreen  
        centerDot.Visible = Config.ShowFOV  
    end

    if currentTarget then  
        if fovCircle then fovCircle.Color = Theme.Text end
        if centerDot then centerDot.Color = Theme.Text end
        if Config.AimMode == "AUTO" and LocalPlayer.Character then  
            local targetPos = currentTarget.Position  
            if currentTarget.Name == "Head" then targetPos = targetPos + Vector3.new(0, 0.2, 0) end  
            local aimNoise = Vector3.new(math.random(-5,5)/100, math.random(-5,5)/100, math.random(-5,5)/100)  
            targetPos = targetPos + aimNoise  
            if Config.AimSpeed >= 100 then  
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)  
            else  
                local smoothFactor = 1 - (Config.AimSpeed / 100)  
                local alpha = 1 - math.pow(smoothFactor, dt * 60)  
                local currentLook = Camera.CFrame.LookVector  
                local targetLook = (targetPos - Camera.CFrame.Position).Unit  
                local newLook = currentLook:Lerp(targetLook, alpha)  
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + newLook)  
            end  
        end  
        if Config.FireMode == "RAPIDO" then
            if tick() - lastShot > 0.04 then
                doClick()
                lastShot = tick()
            end
        elseif Config.FireMode == "LENTO" then
            if tick() - lastShot > 0.55 then
                doClick()
                lastShot = tick()
            end
        end
    else
        if fovCircle then fovCircle.Color = Theme.Glow end
        if centerDot then centerDot.Color = Theme.Glow end
    end  
    updateESP()  
end)  
  
