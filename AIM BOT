-- ── Sistema de Disparo Compatible con Celular ──
local clickingNow = false

local function doClick()
    if clickingNow then return end
    clickingNow = true
    task.spawn(function()
        local ok = false
        if mouse1press and mouse1release then
            ok = pcall(function()
                mouse1press()
                task.wait(0.03)
                mouse1release()
            end)
        end
        if not ok and mouse1click then
            ok = pcall(mouse1click)
        end
        if not ok then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(0, 0))
                task.wait(0.03)
                VirtualUser:Button1Up(Vector2.new(0, 0))
            end)
        end
        clickingNow = false
    end)
end
  
