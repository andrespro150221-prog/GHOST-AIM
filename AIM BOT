local function createESP(player)  
    if ESPCache[player] or not Drawing then return end  
    pcall(function()
        ESPCache[player] = {  
            Box = Drawing.new("Square"),  
            Name = Drawing.new("Text"),  
            HealthBar = Drawing.new("Square"),  
            HealthFill = Drawing.new("Square"),  
            HealthText = Drawing.new("Text"),  
        }  
        local esp = ESPCache[player]  
        esp.Box.Thickness = 1; esp.Box.Filled = false; esp.Box.Transparency = 0.8; esp.Box.Visible = false  
        esp.Name.Size = 13; esp.Name.Center = true; esp.Name.Outline = true; esp.Name.OutlineColor = Color3.new(0,0,0); esp.Name.Visible = false  
        esp.HealthBar.Thickness = 1; esp.HealthBar.Filled = false; esp.HealthBar.Transparency = 0.8; esp.HealthBar.Visible = false; esp.HealthBar.Color = Color3.fromRGB(0,0,0)  
        esp.HealthFill.Thickness = 0; esp.HealthFill.Filled = true; esp.HealthFill.Transparency = 0.4; esp.HealthFill.Visible = false  
        esp.HealthText.Size = 12; esp.HealthText.Center = true; esp.HealthText.Outline = true; esp.HealthText.OutlineColor = Color3.new(0,0,0); esp.HealthText.Visible = false; esp.HealthText.Color = Color3.fromRGB(255,255,255)  
    end)
end  
  
local function removeESP(player)  
    if ESPCache[player] then  
        for _, d in pairs(ESPCache[player]) do pcall(function() d:Remove() end) end  
        ESPCache[player] = nil  
    end
    if HighlightCache[player] then  
        pcall(function() HighlightCache[player]:Destroy() end)  
        HighlightCache[player] = nil  
    end  
end  
  
local function isEnemy(player)  
    if not Config.TeamCheck then return true end  
    if not player.Team or not LocalPlayer.Team then return true end  
    return player.Team ~= LocalPlayer.Team  
end  
  
local function updateESP()  
    for _, player in ipairs(Players:GetPlayers()) do  
        if player ~= LocalPlayer then  
            createESP(player)  
            local esp = ESPCache[player]  
            local char = player.Character  
            local hrp = char and char:FindFirstChild("HumanoidRootPart")  
            local hum = char and char:FindFirstChild("Humanoid")  
            local lChar = LocalPlayer.Character  
            local lHRP = lChar and lChar:FindFirstChild("HumanoidRootPart")  
              
            if Config.TeamCheck and char and hum and hum.Health > 0 then  
                if not HighlightCache[player] or not HighlightCache[player]:IsDescendantOf(game) or HighlightCache[player].Adornee ~= char then  
                    if HighlightCache[player] then  
                        pcall(function() HighlightCache[player]:Destroy() end)  
                    end  
                    pcall(function()
                        local h = Instance.new("Highlight")  
                        h.Name = "FlowCham"  
                        h.Adornee = char  
                        h.FillColor = isEnemy(player) and Color3.fromRGB(255, 45, 85) or Color3.fromRGB(45, 255, 85)
                        h.OutlineColor = isEnemy(player) and Color3.fromRGB(120, 20, 40) or Color3.fromRGB(20, 120, 40)  
                        h.FillTransparency = 0.5
                        h.OutlineTransparency = 0  
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Parent = char  
                        HighlightCache[player] = h  
                    end)
                else  
                    pcall(function()
                        HighlightCache[player].Enabled = true  
                        HighlightCache[player].FillColor = isEnemy(player) and Color3.fromRGB(255, 45, 85) or Color3.fromRGB(45, 255, 85)  
                        HighlightCache[player].OutlineColor = isEnemy(player) and Color3.fromRGB(120, 20, 40) or Color3.fromRGB(20, 120, 40)  
                        HighlightCache[player].DepthMode = Enum.HighlightDepthMode.AlwaysOnTop  
                    end)
                end  
            else  
                if HighlightCache[player] then  
                    pcall(function() HighlightCache[player]:Destroy() end)  
                    HighlightCache[player] = nil  
                end  
            end  
  
            if esp then
                if char and hrp and hum and hum.Health > 0 and lHRP and isEnemy(player) then  
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)  
                    if onScreen then  
                        local dist = (lHRP.Position - hrp.Position).Magnitude  
                        local scale = math.clamp(1 / (dist / 80), 0.4, 3)  
                        local w, h = 35 * scale, 50 * scale  
                        local boxPos = Vector2.new(pos.X - w/2, pos.Y - h/2)  
                        local teamColor = player.Team and player.Team.TeamColor.Color or Color3.fromRGB(200, 200, 200)  
                        esp.Box.Position = boxPos; esp.Box.Size = Vector2.new(w, h); esp.Box.Color = teamColor; esp.Box.Visible = Config.ShowESP  
                        esp.Name.Position = Vector2.new(pos.X, boxPos.Y - 16); esp.Name.Text = player.Name; esp.Name.Color = teamColor; esp.Name.Visible = Config.ShowESP  
                        local hX, hY, hW, hH = boxPos.X - 6, boxPos.Y, 3, h  
                        esp.HealthBar.Position = Vector2.new(hX, hY); esp.HealthBar.Size = Vector2.new(hW, hH); esp.HealthBar.Visible = Config.ShowESP  
                        local healthFrac = hum.Health / math.max(hum.MaxHealth, 1)  
                        esp.HealthFill.Position = Vector2.new(hX, hY + hH * (1 - healthFrac)); esp.HealthFill.Size = Vector2.new(hW, hH * healthFrac); esp.HealthFill.Color = Color3.fromRGB(255,0,0):Lerp(Color3.fromRGB(0,255,0), healthFrac); esp.HealthFill.Visible = Config.ShowESP  
                        local healthColor = Color3.fromRGB(255,0,0):Lerp(Color3.fromRGB(0,255,0), healthFrac)  
                        esp.HealthText.Position = Vector2.new(pos.X, boxPos.Y + h + 4)  
                        esp.HealthText.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)  
                        esp.HealthText.Color = healthColor  
                        esp.HealthText.Visible = Config.ShowESP  
                    else  
                        esp.Box.Visible = false; esp.Name.Visible = false; esp.HealthBar.Visible = false; esp.HealthFill.Visible = false; esp.HealthText.Visible = false  
                    end  
                else  
                    esp.Box.Visible = false; esp.Name.Visible = false; esp.HealthBar.Visible = false; esp.HealthFill.Visible = false; esp.HealthText.Visible = false  
                end  
            end
        end  
    end  
end  
  
