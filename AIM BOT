            if Config.TeamCheck and char and hum and hum.Health > 0 then  
                if not HighlightCache[player] or not HighlightCache[player]:IsDescendantOf(game) or HighlightCache[player].Adornee ~= char then  
                    if HighlightCache[player] then  
                        pcall(function() HighlightCache[player]:Destroy() end)  
