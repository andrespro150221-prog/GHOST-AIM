local function createKeyBind(text, order, defaultKey, onTriggered)
    local keyBtn = Instance.new("TextButton", Content)
    keyBtn.Size = UDim2.new(1, 0, 0, 38)
    keyBtn.BackgroundColor3 = Theme.GlassLight
    keyBtn.BackgroundTransparency = 0.55
    keyBtn.Text = ""
    keyBtn.AutoButtonColor = false
    keyBtn.LayoutOrder = order
    keyBtn.ZIndex = 10
    Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 8)

    local keyStroke = Instance.new("UIStroke", keyBtn)
    keyStroke.Color = Theme.Accent
    keyStroke.Transparency = 0.85
    keyStroke.Thickness = 1

    local keyGrad = Instance.new("UIGradient", keyBtn)
    keyGrad.Rotation = 90
    keyGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.GlassLight),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(22, 25, 33))
    })

    local keyLabel = Instance.new("TextLabel", keyBtn)
    keyLabel.Text = text
    keyLabel.Font = Enum.Font.GothamMedium
    keyLabel.TextSize = 13
    keyLabel.TextColor3 = Theme.Text
    keyLabel.Position = UDim2.new(0, 14, 0, 0)
    keyLabel.Size = UDim2.new(0, 150, 1, 0)
    keyLabel.TextXAlignment = Enum.TextXAlignment.Left
    keyLabel.BackgroundTransparency = 1
    keyLabel.ZIndex = 11

    local keyValueLabel = Instance.new("TextLabel", keyBtn)
    keyValueLabel.Name = "KeyValue"
    keyValueLabel.Text = "[" .. defaultKey.Name .. "]"
    keyValueLabel.Font = Enum.Font.GothamBold
    keyValueLabel.TextSize = 13
    keyValueLabel.TextColor3 = Theme.Accent
    keyValueLabel.Size = UDim2.new(1, -15, 1, 0)
    keyValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    keyValueLabel.BackgroundTransparency = 1
    keyValueLabel.ZIndex = 11

    table.insert(interactiveElements, keyBtn)

    local boundKey = defaultKey
    local listening = false

    keyBtn.Activated:Connect(function()
        if listening then return end
        listening = true
        keyValueLabel.Text = "[ ... ]"
        keyValueLabel.TextColor3 = Theme.TextDim

        local blinkActive = true
        local blinkState = true
        local blinkConn
        blinkConn = RunService.Heartbeat:Connect(function()
            if not blinkActive then
                blinkConn:Disconnect()
                return
            end
            blinkState = not blinkState
            keyValueLabel.TextColor3 = blinkState and Theme.TextDim or Theme.Accent
        end)

        local inputConn
        inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                blinkActive = false
                blinkConn:Disconnect()
                inputConn:Disconnect()
                boundKey = input.KeyCode
                keyValueLabel.Text = "[" .. boundKey.Name .. "]"
                keyValueLabel.TextColor3 = Theme.Accent
                listening = false
            end
        end)
    end)

    keyBtn.MouseEnter:Connect(function()
        Tween(keyBtn, {BackgroundTransparency = 0.3}, 0.15)
    end)
    keyBtn.MouseLeave:Connect(function()
        Tween(keyBtn, {BackgroundTransparency = 0.6}, 0.15)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if listening then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == boundKey then
                onTriggered(keyValueLabel)
                Tween(keyValueLabel, {TextColor3 = Theme.Text}, 0.1)
                task.delay(0.25, function()
                    if not listening then
                        Tween(keyValueLabel, {TextColor3 = Theme.Accent}, 0.2)
                    end
                end)
            end
        end
    end)

    return keyValueLabel
end
  
